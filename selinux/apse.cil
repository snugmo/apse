(typeattributeset mcs_constrained_type (apse_t apse_app_t apse_shim_t))
; `apse_exec_t` is a standard application executable: it carries the
; same attribute set the base policy gives `ssh_exec_t` /
; `useradd_exec_t` / `sudo_exec_t` (`seinfo -t <type> -x`). That set
; is what a module type must opt into, because module types join no
; attribute by default (LESSONS #53). What the set does and does not
; do:
;   - `file_type`: `unconfined_t` (via `files_unconfined_type`) gets
;     the full file lifecycle on the binary — including the `unlink`
;     a bare module type misses. In the base policy the only
;     user-space writer of `file_type` is `unconfined` itself
;     (`kernel_t` is the kernel; `init_t`/`secadm_t`/`setfiles_t`
;     are relabel-only), and no write grant on any of these
;     attributes reaches `apse_t`/`apse_app_t` — so membership does
;     not open a write hole in the privileged binary.
;   - `exec_type`/`entry_type`/`application_exec_type`: mark the type
;     as an executable to the policy family (universal read, the
;     `exec_type:file execute` grants) — parity with every other
;     app binary.
;   - `non_auth_file_type`/`non_security_file_type`: the remaining
;     members of the standard set; their write grants (tmpfiles,
;     boolean-gated file sharing) apply identically to
;     `ssh_exec_t` and friends, so this is parity, not a delta.
(typeattributeset file_type (apse_exec_t))
(typeattributeset exec_type (apse_exec_t))
(typeattributeset entry_type (apse_exec_t))
(typeattributeset application_exec_type (apse_exec_t))
(typeattributeset non_auth_file_type (apse_exec_t))
(typeattributeset non_security_file_type (apse_exec_t))
; this kernel's process class splits `signal` into signull (kill 0),
; sigkill and signal. The base policy's mlsconstrain list constrains
; ptrace/signal/sigkill/sigstop — but NOT signull. A module CIL cannot
; add an mlsconstrain rule (the libsepol CIL reader rejects it:
; "Bad constrain declaration"), so the signull grants in the process
; allow rules below (terminate_app's kill -0 liveness probe, and
; strace-style tools) stay *unconstrained* by MCS: any cN apse
; subject may kill -0 any apse process, including another
; instance's. That is a documented limitation of the module-based
; approach, not a bug — see LESSONS #33.
; the full file lifecycle on the binary (install/update/delete from
; the user shell — cp's `ioctl` probe, the update's write, `rm`'s
; unlink) now comes from `file_type` membership: the same
; `files_unconfined_type` catch-all by which unconfined deletes
; `ssh_exec_t`. The one permission attribute membership does not
; cover is `entrypoint`, granted explicitly the way the base policy
; does for standard binaries (per-type, from the defining module —
; see the role grants on `sudo_exec_t`): it is required for the
; `unconfined_t -> apse_t` transition below.
(allow unconfined_t apse_exec_t (file (entrypoint)))
; the user can signal apse processes (stop / cleanup of runs;
; kill -9 needs the explicit sigkill, strace probes with signull)
(allow unconfined_t apse_t (process (getattr noatsecure rlimitinh siginh transition signal sigkill signull)))
; external clients (the compositor, `apse decide` from other
; shells, tools) connect to apse's sockets; data then flows both
; ways between the two sockets
; userspace tools (ls, cat) inspecting apse's /proc entries
(allow unconfined_t apse_t (lnk_file (getattr read)))
; the compositor (and other session processes) use apse's sockets.
; `fd use` is the SCM_RIGHTS dup of the tagged listener (and the
; reference pipe) that `create_listener` hands the compositor — without
; it the compositor's dup fails and libwayland-server reports a
; protocol-level "invalid arguments for ...create_listener". The
; socket grants cover accepting the per-connection tagged socket the
; proxy opens upstream, reading/writing the Wayland protocol on it,
; plus the reference pipe's EOF (the untag when the proxy exits);
; getattr is the strace/getsockopt probe. The socket and fd classes
; are not in this kernel's base mlsconstrain, so the full-range
; unconfined subject passes the level check against the cN socket.
(allow unconfined_t apse_t (fd (use)))
(allow unconfined_t apse_t (unix_stream_socket (accept connectto getattr getopt read write setopt)))
(allow unconfined_t apse_t (fifo_file (read write)))
; the user can trace apse processes (strace/gdb while iterating on them:
; the kernel re-checks the tracer's ptrace permission on the *new* context
; at every SID-changing exec, so without this even `strace apse --help`
; dies with EPERM — selinux_bprm_creds_for_exec, LSM_UNSAFE_PTRACE)
(allow unconfined_t apse_t (process (ptrace)))
(allow unconfined_t apse_t (dir (getattr open read search)))
(allow unconfined_t apse_t (file (getattr ioctl open read)))
; the shim `.so` sits in the user's own per-instance runtime dir
; (the instance dir is `user_tmp_t`, user territory): without a
; grant here the user's shell cannot even `stat` it (the entry shows
; as `-??????????` in `ls`) or `unlink` it, and `rm -rf` on the
; instance dir fails — `sudo` included (root bypasses DAC, not MAC).
; Deliberately *not* `read`/`execute`/`map`: only the two consumer
; types hold those, so a stray unconfined process can at most see
; and delete the file, never load it.
(allow unconfined_t apse_shim_t (file (getattr unlink)))
; the user can signal the sandboxed app's host-visible process
; (signull: the kill -0 liveness probe, strace-style tools)
(allow unconfined_t apse_app_t (process (getattr noatsecure rlimitinh siginh signal sigkill signull ptrace)))
(allow unconfined_t xserver_t (process (getattr noatsecure rlimitinh siginh signal sigkill signull ptrace)))
; the host's own tools (ps, htop, ls -Z, cat /proc/<pid>/…): on this
; kernel the whole /proc/<pid>/ tree is labeled with the target
; process's own context (LESSONS #45), so observing a sandboxed
; process or a satellite is a check against *their* types, not
; proc_t — getattr is the path-lookup permission every one of them
; needs first (open/read alone do not make the path resolvable).
(allow unconfined_t apse_app_t (dir (getattr open read search)))
(allow unconfined_t apse_app_t (file (getattr open read)))
(allow unconfined_t apse_app_t (lnk_file (getattr read)))
; the per-app state tree: the user's unconfined session gets the
; same effective lifecycle on it that the base policy gives on the
; home types — where it comes from *there* (the `userdomain`-family
; dir grant plus the `file_type` attribute grant) and does not
; reach this type (a module type joins no attribute, LESSONS #53),
; so it is mirrored here explicitly. The tree is the user's own
; 0700 data: DAC bounds every grant below to the owner's session,
; so this is parity with the real home, not a new trust edge.
; Included beyond inspection: the test-suite apse (unrelabeled, so
; `unconfined_t`) runs the same pipeline as the confined one — the
; `prepare_app_state` 0700 chmods (`setattr`) and A's private-home
; binds (`mounton` — after the home bind has replaced `/home/user`
; with the tree's `home` subdir, every XDG bind target is a tree
; dir, as for `apse_t` above) — and the app the tests run inside
; the sandbox writes, renames and execs in it like any home
(allow unconfined_t apse_state_t (dir (add_name create getattr ioctl lock mounton open read remove_name rmdir search setattr unlink watch write)))
(allow unconfined_t apse_state_t (file (append create execute execute_no_trans getattr ioctl lock map open read rename setattr unlink write)))
(allow unconfined_t apse_state_t (lnk_file (create getattr read unlink)))
; connectto: a user client pointing at the instance's public D-Bus
; socket (the dbus-proxy sidecar's) or at any socket the app created
; — the socket object carries the *creator's* SID (the app's), so
; the connect is checked against apse_app_t, not the file's.
(allow unconfined_t apse_app_t (unix_stream_socket (connectto read write)))
; the compositor (and any other unconfined session process) receives
; the app's in-memory objects through the relay's SCM_RIGHTS forward:
; the same `__file_has_perm` double-check as the relay's own receive —
; `fd:use` against the memfd's creator context (the app's SID), then
; the file perms implied by the fd's f_mode (base-policy grants cover
; the file side; only the app type is new to policy). A denial drops
; the fd from the received cmsg (MSG_CTRUNC) and the compositor
; rejects the message as "invalid arguments".
(allow unconfined_t apse_app_t (fd (use)))
(allow unconfined_t apse_t (dbus (send_msg)))
(allow unconfined_t apse_app_t (dbus (send_msg)))
(typetransition unconfined_t apse_exec_t process apse_t)
(allow apse_t apse_app_t (process (transition dyntransition noatsecure)))
(typetransition apse_t bin_t process apse_app_t)
(typetransition apse_t shell_exec_t process apse_app_t)
(typetransition apse_t user_home_t process apse_app_t)
; the app's files in the *real* `~/.local/*` are `gconf_home_t`
; (host mode — the gnome module's `\.local(/.*)?` filecon labels
; all of `~/.local` but `.local/share`), so the fallback
; transition (an exec without the exec context) covers them
(typetransition apse_t gconf_home_t process apse_app_t)
; decision #43 (refined): the private home's files are
; `apse_state_t` — the dedicated type for the per-app state tree
; (see the type's comment); the same fallback transition covers
; an exec out of them
(typetransition apse_t apse_state_t process apse_app_t)
; the state tree's root is created by S under `~/.local/state`
; (`gconf_home_t`). This named filetrans is *the* creation-time
; mechanism (on this kernel `filecon` does not label created
; inodes — see the `apse_state_t` comment): a dir named `apse`
; that `apse_t` creates under a `gconf_home_t` parent is born
; `apse_state_t`, and everything below it inherits the label
; (the no-rule default is the parent's own type — children need
; no rule). This module-store CIL dialect spells a filename
; transition as the five-field `typetransition`
; (`(typetransition src tgt class "name" child)` — verified
; against libsepol 3.11's CIL reader, which has no `filetrans`
; keyword); the four-field form is the process transition
(typetransition apse_t gconf_home_t dir "apse" apse_state_t)
(allow apse_app_t bin_t (process (noatsecure rlimitinh siginh)))
(allow apse_app_t shell_exec_t (process (noatsecure rlimitinh siginh)))
(allow apse_app_t user_home_t (process (noatsecure rlimitinh siginh)))
(allow apse_app_t gconf_home_t (process (noatsecure rlimitinh siginh)))
(allow apse_app_t apse_state_t (process (noatsecure rlimitinh siginh)))
(allow apse_app_t lib_t (process (noatsecure rlimitinh siginh)))
(allow apse_app_t usr_t (process (noatsecure rlimitinh siginh)))
; the exec-time SID change into `xserver_t` (the satellite's
; `typetransition` on `xserver_exec_t`, below) needs the new-process
; checks against the *new* SID, not just the transition permission
; itself: without `noatsecure/siginh/rlimitinh` the exec of Xwayland
; is denied even though the typetransition itself passes.
(allow apse_t xserver_t (process (transition dyntransition noatsecure rlimitinh siginh signal sigkill)))
(typetransition apse_t xserver_exec_t process xserver_t)
(allow apse_t xserver_exec_t (file (entrypoint execute getattr map open read)))
(allow apse_t apse_exec_t (file (entrypoint execute execute_no_trans getattr map open read)))
(allow apse_t apse_t (process (dyntransition fork getattr getsched getsession getrlimit noatsecure ptrace rlimitinh setcurrent setexec setfscreate setkeycreate setpgid setsockcreate transition sigchld siginh signal sigkill signull sigstop)))
(allow apse_t apse_t (dir (search)))
(allow apse_t apse_t (file (append create getattr map open read unlink write)))
; listen(2) is checked against the socket's own context (the
; kernel's selinux_socket_listen → sock_has_perm), so a listener
; must be allowed to `listen` on its own sockets
(allow apse_t apse_t (unix_stream_socket (accept bind connect connectto create getattr read write getopt setopt listen)))
(allow apse_t apse_t (udp_socket (create getattr ioctl read write getopt setopt)))
(allow apse_t apse_t (fifo_file (read write)))
(allow apse_t apse_t (lnk_file (read)))
(allow apse_t apse_t (fd (use)))
; dac_override: B's mount of proc (and the fresh tmpfs / dev) is a
; capability-gated path lookup in the new userns — the kernel falls
; back to CAP_DAC_OVERRIDE (class cap_userns) when the mount-point
; check fails; without it the mount still succeeds (the app's uid
; matches the fresh-rootfs inodes) but a denial is logged every run
(allow apse_t apse_t (cap_userns (sys_admin sys_chroot sys_ptrace net_admin dac_override)))
(allow apse_t apse_t (user_namespace (create)))
(allow apse_t file_type (filesystem (mount remount unmount transition)))
(allow apse_t file_type (dir (mounton)))
(allow apse_t tmp_t (dir (create getattr open search read write add_name remove_name rmdir mounton setattr)))
(allow apse_t tmp_t (file (append create getattr map open read write unlink mounton)))
; `--listen /tmp/foo.sock`: a plain tmp socket. `setattr` is the
; chmod(0600) the SIGHUP in-place re-exec does when it re-binds a
; pre-existing socket (the re-exec re-runs `bind_listener`, which
; resets the mode on every bind — including one that just reuses a
; live socket).
(allow apse_t tmp_t (sock_file (create getattr open read write unlink setattr)))
(allow apse_t cgroup_t (dir (create getattr open search read write add_name remove_name rmdir)))
(allow apse_t cgroup_t (file (getattr open read write)))
(allow apse_t unconfined_t (system (start)))
(allow apse_t unconfined_t (fd (use)))
; host-side apse stdout/stderr go through shell-created pipes
; (the ioctl is the isatty probe)
(allow apse_t unconfined_t (fifo_file (read write ioctl)))
; the upstream connect (the compositor's wayland socket, created by
; an unconfined session process) plus the replies to those external
; clients. connectto is checked against the *socket's* context (the
; creator's type/range), not the path file's; the socket and fd
; classes are not in this kernel's base mlsconstrain list, so the
; category-narrowed subject (s0:cN) passes the level check here
(allow apse_t unconfined_t (unix_stream_socket (connectto read write)))
(allow apse_t unconfined_t (dbus (send_msg)))
; S supervises the app: the courtesy TERM, the kill -0 liveness
; probe (terminate_app) and the SIGKILL escalation
(allow apse_t apse_app_t (process (getattr noatsecure ptrace rlimitinh sigkill siginh signull signal)))
(allow apse_t apse_app_t (process2 (nnp_transition)))
(allow apse_t apse_app_t (dir (search)))
; the app's in-memory objects (a `memfd_create` buffer — the
; `wl_shm` pool foot hands the compositor — or a pipe/socket passed
; as a clipboard `receive` target) carry the app's own context:
; an anonymous inode is labeled `current_sid()` at creation, and
; the file object's SID is the creator's context too. The kernel's
; SCM_RIGHTS receive path (`scm_detach_fds` → `receive_fd` →
; `security_file_receive` → `__file_has_perm`) checks the
; *receiving* process — here, the relay — twice: first `fd:use`
; (sender SID ≠ file SID), then the file permissions implied by the
; object's `f_mode` (a RW pool needs read+write on the inode's
; type). A denial drops the fd from the received cmsg: recvmsg
; still returns the message bytes with MSG_CTRUNC set — invisible
; unless the receiver checks the flag, which the relay now does
; (`ProxySocket::recv`). Without `fd:use` and `write`, every
; `create_pool` the app sends (and every in-memory clipboard read)
; dies at the relay.
(allow apse_t apse_app_t (fd (use)))
(allow apse_t apse_app_t (file (open read write)))
(allow apse_t apse_app_t (fifo_file (read write)))
(allow apse_t apse_app_t (unix_stream_socket (read write)))
; S resolves the app's cwd (dirfd-relative path resolution): the
; /proc/<pid>/cwd symlink carries the *app's* type, not proc_t
(allow apse_t apse_app_t (lnk_file (read)))
(allow apse_t root_t (dir (getattr search)))
(allow apse_t var_t (dir (search)))
(allow apse_t var_run_t (dir (search)))
(allow apse_t proc_t (dir (getattr search)))
(allow apse_t proc_t (lnk_file (read)))
; NOTE: /proc/<pid>/ (incl. comm and attr/) is labeled with the
; *target process's own context*, not by the proc_t genfs rules:
; the pident inodes take the task's sid at creation
; (security_task_to_inode) and are re-labeled on every credential
; change (pid_update_inode — so our setexecfilecon execs re-label
; the execing process's own /proc/self/ tree). The comm restore in
; main() therefore needs no proc_t grant: the process writes its
; own comm, which is its own type (the apse_t → apse_t file
; allow above). The kernel additionally restricts comm writes to
; the owning thread group (7.2.11 `comm_write`), so only self-
; writes are possible anyway.
(allow apse_t sysfs_t (dir (getattr search)))
(allow apse_t etc_t (dir (getattr search)))
(allow apse_t usr_t (dir (getattr open read search)))
(allow apse_t bin_t (dir (getattr search)))
; `execute_no_trans`: the on-demand shim compile (decision #42) pins
; the `cc` vforked by `ensure_shim` to *this* domain (a same-domain
; exec — the bprm check then requires `execute_no_trans`, not
; `execute` + the `typetransition` above); the compiler's own
; children (cc1/as/ld, all `bin_t`) take the same path.
(allow apse_t bin_t (file (entrypoint execute execute_no_trans getattr map open read)))
(allow apse_t bin_t (lnk_file (read)))
(allow apse_t bin_t (process (noatsecure rlimitinh siginh)))
(allow apse_t shell_exec_t (file (entrypoint execute execute_no_trans map open read)))
(allow apse_t lib_t (dir (getattr search)))
(allow apse_t lib_t (file (execute getattr map open read)))
(allow apse_t lib_t (lnk_file (read)))
(allow apse_t ld_so_t (file (execute map open read)))
(allow apse_t ld_so_cache_t (file (getattr map open read)))
(allow apse_t locale_t (dir (search)))
(allow apse_t locale_t (file (getattr map open read)))
(allow apse_t tmpfs_t (dir (add_name create getattr search setattr write)))
; the app's `wl_shm` buffer: foot `memfd_create`s its pixel pool and
; passes the fd to the relay over the downstream socket (SCM_RIGHTS).
; That memfd is an anonymous inode in the sandbox's fresh `/dev/shm`
; tmpfs, so it carries the tmpfs's default label (`tmpfs_t`) — NOT the
; app's SID (`apse_app_t`): an anonymous inode in a fresh tmpfs takes
; the mount's fs label, and `default_range … target low` pins it to `s0`
; (LESSONS #29). The relay is the *receiving* end of the SCM_RIGHTS dup,
; so the kernel's `security_file_receive` → `__file_has_perm` checks the
; *relay* (not the app) against the memfd's type: `fd:use` (receiving
; SID ≠ file SID) plus the file perms the fd's `f_mode` implies (an
; `O_RDWR` pool → read+write). A denial drops the fd from the received
; cmsg — the message bytes arrive intact with `MSG_CTRUNC` set, so the
; relay only sees it if it checks the flag (`ProxySocket::recv`), which
; it now does. `write` is kept beside `read` because the pool is
; read-write and `__file_has_perm` checks both from `f_mode`.
(allow apse_t tmpfs_t (fd (use)))
(allow apse_t tmpfs_t (file (create mounton open read write)))
(allow apse_t tmpfs_t (lnk_file (create)))
(allow apse_t home_root_t (dir (getattr open read search)))
(allow apse_t user_home_dir_t (dir (getattr search)))
(allow apse_t user_home_t (dir (getattr search)))
(allow apse_t config_home_t (dir (getattr search)))
; the per-app profile: S reads `~/.config/apse/apps/<app-id>.toml`
; before the first fork (a `config_home_t` *file* — the dir search
; above covers only traversal). A stat/getattr denial makes
; `Path::is_file()` return false, and `profile::load` silently
; degrades to the empty ad-hoc profile (the session's env then leaks
; into the app — LESSONS #34).
(allow apse_t config_home_t (file (getattr open read)))
(allow apse_t data_home_t (dir (getattr)))
(allow apse_t cache_home_t (dir (getattr)))
(allow apse_t gconf_home_t (dir (getattr search)))
; decision #43: the per-app private state tree
; (`$XDG_STATE_HOME/apse/<app>/` — on Fedora `~/.local/state`,
; `gconf_home_t`) is created by S before the first fork: a `mkdir`
; at each level (`add_name` + `write` on the parent, `create` +
; `getattr` on the new inode) and the 0700 `chmod` (`setattr`).
; The tree is bound into the scratch and over the app's home/XDG
; locations as *bind sources* — the same checks as the
; per-instance runtime-dir carry (decision #28), which passes on
; the `getattr`/`search` above.
(allow apse_t gconf_home_t (dir (add_name create getattr open read search write setattr)))
; decision #43 (refined): the per-app state tree is the dedicated
; `apse_state_t`, not `gconf_home_t` (that grant above now serves
; the *parent* dir `~/.local/state` only: the `mkdir` of the
; `apse` root into it, the traversal, the 0700 chmod). S creates
; the tree (`add_name`/`write` on the parent, `create` on the new
; inode, the 0700 `setattr`) and then relabels it — the whole
; `~/.local/state/apse` subtree, every app's tree in one pass —
; with the setxattr walk: the 7.2 relabel path checks ownership,
; `relabelfrom` (subject → the inode's old label), `relabelto`
; (subject → this one), the class `validatetrans` constraint,
; and `filesystem:associate` (this SID → the mount's SID), the
; same as the `apse_shim_t` relabel above; the pre-check label
; read (`getxattr "security.selinux"`) carries no MAC check on
; this kernel, so `getattr`/`read` here serve the walk's own
; enumeration (getdents) and stat of the dirs it descends. The
; old label of a straggler is `gconf_home_t` (a pre-module tree)
; or the home family (a custom `XDG_STATE_HOME` parent); the
; `associate` grants' *subject* is the new label's SID, as for
; `apse_exec_t`/`apse_shim_t`: `fs_t` is the seclabel home fs,
; the `tmpfs_t`/`unlabeled_t` pair the shim's (a custom XDG on a
; tmpfs).
; `mounton`: A's private-home binds (step 7) land on the tree's
; own dirs — once the home bind has replaced `/home/user` with the
; tree's `home` subdir, every later XDG bind target
; (`.config`, `.cache`, …) resolves to a `home/…` subdir of the
; tree. The explicit grant, not the `file_type` attribute one
; above: a module type joins no base attribute (LESSONS #53), so
; `apse_t file_type (dir (mounton))` never reaches this type
(allow apse_t apse_state_t (dir (create getattr open read search write add_name remove_name rmdir setattr mounton relabelfrom relabelto)))
(allow apse_t apse_state_t (file (create getattr open read write unlink relabelfrom relabelto)))
(allow apse_t apse_state_t (lnk_file (getattr read relabelfrom relabelto)))
(allow apse_t apse_state_t (sock_file (create getattr open read write unlink setattr)))
(allow apse_t apse_state_t (unix_stream_socket (accept bind connect connectto create getattr read write getopt setopt listen)))
(allow apse_state_t fs_t (filesystem (associate)))
(allow apse_state_t tmpfs_t (filesystem (associate)))
(allow apse_state_t unlabeled_t (filesystem (associate)))
; the walk's `relabelfrom` on the old labels of the stragglers it
; relabels (a pre-module tree is `gconf_home_t`; a custom
; `XDG_STATE_HOME` parent carries the home-family label of the
; dir that holds it):
(allow apse_t gconf_home_t (dir (relabelfrom)))
(allow apse_t gconf_home_t (file (getattr relabelfrom)))
(allow apse_t user_home_t (dir (read relabelfrom)))
(allow apse_t user_home_t (file (getattr relabelfrom)))
(allow apse_t data_home_t (dir (read relabelfrom)))
(allow apse_t data_home_t (file (getattr relabelfrom)))
(allow apse_t cache_home_t (dir (read relabelfrom)))
(allow apse_t cache_home_t (file (getattr relabelfrom)))
(allow apse_t config_home_t (dir (relabelfrom)))
(allow apse_t config_home_t (file (relabelfrom)))
; setattr: chmod of created dirs (mode 0700) and of the sockets
; (bind_listener sets 0600)
(allow apse_t user_tmp_t (dir (create getattr open search read write add_name remove_name rmdir setattr)))
; `relabelfrom`: the pdeathsig-restore shim's relabel to
; `apse_shim_t` (below) starts from this type — the `.so` is
; created here (the default label for files in the instance dir)
; before `ensure_shim` sets the shim label on it.
(allow apse_t user_tmp_t (file (append create getattr ioctl open read write unlink relabelfrom)))
(allow apse_t user_tmp_t (sock_file (create getattr open read write unlink setattr)))
; the relay receives the compositor's shm fds (the XKB keymap file,
; clipboard buffers) over SCM_RIGHTS — the receive-side `fd:use`
; against the file's type (those files are `user_tmp_t`: the
; `/dev/shm` file transition of an unconfined creator)
(allow apse_t user_tmp_t (fd (use)))
; decision #42: `ensure_shim` compiles the pdeathsig-restore `.so`
; into the instance runtime dir and relabels it to `apse_shim_t`.
; The 7.2 setxattr relabel path (selinux_inode_setxattr) checks
; `file:relabelfrom` (subject → the old label, the user_tmp_t rule
; above), `file:relabelto` (subject → this label), and
; `filesystem:associate` — whose *subject* is the **new** label's
; SID (this type, not the relabelling subject) and whose target is
; the **mount's** SID: the host's `/run/user/<uid>` tmpfs the
; runtime dir sits on carries `tmpfs_t` (the sbsec default for a
; plain tmpfs on this kernel — a *seclabel-only* tmpfs, i.e. one
; without any fs type, would carry `unlabeled_t`; kept for that).
; The teardown sweep unlinks the `.so` (it keeps its label until
; then).
(allow apse_t apse_shim_t (file (getattr relabelto unlink)))
(allow apse_shim_t tmpfs_t (filesystem (associate)))
(allow apse_shim_t unlabeled_t (filesystem (associate)))
(allow apse_t user_tmp_t (unix_stream_socket (accept bind connectto create getattr read write getopt setopt)))
(allow apse_t session_dbusd_tmp_t (sock_file (getattr open read write)))
(allow apse_t unconfined_dbusd_t (unix_stream_socket (accept connectto getattr read write getopt setopt)))
(allow unconfined_dbusd_t apse_t (unix_stream_socket (accept getattr read write)))
(allow apse_t unconfined_dbusd_t (dbus (send_msg acquire_svc)))
(allow unconfined_dbusd_t apse_t (dbus (send_msg)))
(allow apse_t null_device_t (chr_file (open read write getattr ioctl)))
(allow apse_t urandom_device_t (chr_file (open read write getattr)))
(allow apse_t random_device_t (chr_file (getattr)))
(allow apse_t zero_device_t (chr_file (getattr)))
(allow apse_t ptmx_t (chr_file (open read write getattr)))
(allow apse_t devtty_t (chr_file (open read write getattr)))
(allow apse_t user_devpts_t (chr_file (ioctl read write)))
(allow apse_t dri_device_t (chr_file (open read write getattr)))
(allow apse_t device_t (dir (getattr open search read)))
(allow apse_app_t apse_app_t (process (fork getcap getattr signal sigkill signull sigstop getsched getsession getrlimit setpgid setcurrent setexec setfscreate setkeycreate setsockcreate noatsecure rlimitinh siginh sigchld)))
(allow apse_app_t apse_app_t (dir (create getattr open search read watch add_name remove_name rmdir lock ioctl)))
(allow apse_app_t apse_app_t (file (append create entrypoint execute execute_no_trans getattr map open read write unlink lock ioctl)))
; Completeness pass (v2.25): the *entire* base `domain.te` self-grant
; set, granted explicitly to `apse_app_t` instead of joining the
; `domain` attribute. Line-by-line against `domain.te` (the macro
; expansions are literal — raw CIL has no macros):
;   `self:dir { list_dir_perms watch_dir_perms }` → the dir rule above
;     (`list_dir_perms` adds `lock`/`ioctl` to what we already had;
;     `watch` is inotify on our own dirs)
;   `self:lnk_file { read_lnk_file_perms lock ioctl }` → the lnk_file
;     rule in this block
;   `self:file rw_file_perms` → the file rule above (`rw_file_perms`
;     adds `ioctl`/`lock` — flock on our own files is the lockfile
;     pattern; `map` is carried in the self rule itself — the
;     tunable-gated case, kept for our own files only)
;   `self:fifo_file rw_fifo_file_perms` (+ `manage_fifo_file_perms`
;     under `fips_mode`, which is *on* on this box) → the fifo rule
;     below, which is the `manage` superset
;   `self:sem`/`self:shm` → the literal `create_sem_perms`/
;     `create_shm_perms` expansions (those classes have no `ioctl`)
;   `self:process { getcap fork getsched signal_perms }` → the
;     process rule above (a superset)
;   `domain:fd use` (`domain_fd_use`, on on this box — a dup of an
;     app-created fd is checked against the *creator's* type, i.e.
;     self) → the fd rule below
;   `domain:key { link search }` (the `hide_broken_symptoms` hygiene
;     block — a missing key grant degrades into confusing failures,
;     not a clean EACCES) → the key rule below
;   `file_type:file/chr_file/blk_file/lnk_file map` (gated by
;     `domain_can_mmap_files`, *off* on this box — so even mozilla_t
;     and mplayer_t don't get it; check with `getsebool`, the
;     sesearch `:True` annotation is the condition's polarity, not
;     the value) → deliberately *not* mirrored (dropped in v2.28 as
;     too broad: `file_type` is the whole file class — revisit on a
;     `map` denial; the self rule keeps `map` on our own files)
;   `fips_mode`: `kernel_read_kernel_sysctls` (a /proc/sys *content*
;     grant) is the block's only non-self rule and is deliberately
;     *not* mirrored — the v2.24 /proc design keeps content access
;     closed until a denial asks for it (the README's tuning notes)
; Why not `typeattribute apse_app_t domain`: the attribute is
; two-sided, and the side that matters is the one where `domain`
; is the *subject*. Joining it adds every active `domain → X`
; rule to the app — 121 of them across 74 host types (126/76
; counting the rules gated by off-tunables), measured against
; the live avtab: `dir`/`file`/`lnk_file` reads across
; `base_file_type`/`base_ro_file_type`/`security_t`/
; `selinux_config_t`/`var_log_t` and the user/man/font/locale
; families, `context translate`+its socket to `setrans_t` (the
; context-translation daemon), `connectto`+`dbus send_msg` to
; `systemd_resolved_t`, `system module_request` to `kernel_t`
; (the `domain_kernel_load_modules` tunable is on), `process
; {sigchld signull}` probes to `init_t`/`sysadm_t`/
; `unconfined_t`/`abrt_*`/`spc_t`/`livecd_t`/`install_t`, and
; socket-receive grants against
; `unconfined_domain_type`/`netlabel_peer_t`/`ipsec_spd_t` (plus
; `AF_PACKET` against `unlabeled_t`). That is the app→host
; *escape* direction — the exact asymmetry the sandbox exists to
; enforce (the intended direction is the reverse: the host user
; may kill the app, as with a rootless podman container, but the
; app may never reach the host). In the *normal* sandbox most of
; it is gated anyway — the private pidns hides host PIDs (so the
; `process` probes are moot), the rebuilt rootfs hides host
; inodes (so the file grants reach only what a profile
; bind-mounts in), and nono's seccomp floor filters the sockets
; and the `mount`/`AF_PACKET` syscalls — which is precisely why
; `container_t` can be a `domain` member without incident: a
; privileged container *runtime* domain (260 attributes, incl.
; `can_load_policy`/`can_setenforce` — the svirt orchestrator of
; a private pidns with mapped uids), not a confined application.
; But apse's primary controls (ns/landlock/seccomp) are all
; built by apse itself, in one process tree, and the app runs as
; its *real* uid (no uid mapping, decision #9) — it lacks
; podman's uid-isolation safety net — so the SELinux module is
; the *independent second layer* (defense in depth):
; pre-emptively granting it the full `domain` subject-side reach
; would disarm that backstop the moment a primary control has a
; hole. The *other* side (`X → domain`, 851 active rules, e.g.
; `unconfined_domain_type → domain: process {signal sigkill …}
; file … socket …`) is the host→app direction and is fine by
; design — *not* a reason to reject the attribute (the host user
; managing its own app is the podman model; joining would simply
; broaden our audited `unconfined_t → apse_app_t: process …`
; line into the full surface, which is within the same-user
; threat model). (The base process neverallows are *not* a
; blocker either: the FSP 45.24 source carries three — `domain →
; ~domain:process {transition dyntransition}` (domain.te:59) and
; the two wider ones at :116-117 — but the installed policy
; enforces none of them (the transitions the module declares
; today sit squarely in their covered directions and have loaded
; cleanly in enforcing since v2.13 — a violation is refused at
; `semodule -i`), and joining adds none: the module declares no
; transition from `apse_app_t` as subject, and the ones it does
; declare keep their subjects' membership.) The remaining reason
; is maintenance: base drift — a future `domain.te` change (a
; tunable flip, a new grant) would reach the app silently; the
; explicit mirror is audited in the enforcing-mode tuning loop (a
; denial → a grant). All self-grants are MCS-bounded in effect:
; a single-level `s0:cN` subject dominates only same-category
; objects.
(allow apse_app_t apse_app_t (fd (use)))
(allow apse_app_t apse_app_t (key (link search)))
(allow apse_app_t apse_app_t (sem (associate create destroy getattr read write setattr unix_read unix_write)))
(allow apse_app_t apse_app_t (shm (associate create destroy getattr lock read write setattr unix_read unix_write)))
; the app's *own* pipes and named pipes: the `manage_fifo_file_perms`
; set (the `fips_mode` variant of `domain.te` — on on this box), so
; the app can mkfifo, open, chmod, rename and unlink its own fifos,
; not just read/write them; covers the shell-pipeline case (sh
; `fstat`s the pipe ends — getattr) too. Every intra-app pipeline
; without it is EACCES; mirror of the apse_t self-fifo rule above.
(allow apse_app_t apse_app_t (fifo_file (create open getattr setattr read write append rename link unlink ioctl lock)))
; the app's shell (exec'd via /bin/sh or a subshell): entrypoint
; is the check of the *new* (exec-context) context at the apse_t
; → apse_app_t exec, execute_no_trans the same-type subshell
; execs, both against the file's shell_exec_t label
(allow apse_app_t shell_exec_t (file (entrypoint execute execute_no_trans getattr map open read)))
(allow apse_app_t apse_t (dir (getattr open read search)))
(allow apse_app_t apse_t (file (getattr open read)))
(allow apse_app_t apse_t (sock_file (getattr open read)))
(allow apse_app_t apse_t (unix_stream_socket (accept connectto create getattr read write getopt setopt)))
(allow apse_app_t apse_t (fifo_file (read write)))
(allow apse_app_t apse_t (fd (use)))
(allow apse_app_t unconfined_t (fd (use)))
(allow apse_app_t unconfined_t (unix_stream_socket (read write)))
(allow apse_app_t unconfined_t (fifo_file (read write ioctl)))
(allow apse_app_t user_tmp_t (dir (create getattr open search read write add_name remove_name)))
; the isatty probe on a host-redirected stderr/stdout file (sh's
; TIOCGPGRP before it writes — harmless on a regular file, it just
; needs to be answerable)
; `setattr`: the pdeathsig shim's `setexecfilecon` relabel of its own
; `apse_shim_t` copy (the relabel writes the new xattr onto a
; `user_tmp_t` file in the per-instance runtime dir)
(allow apse_app_t user_tmp_t (file (append create getattr ioctl open read write unlink setattr)))
; `unlink`: the app-side cleanup of its own instance-dir sockets on
; shutdown (the D-Bus proxy's glib socket unlinks the file on
; dispose) — without it a clean exit leaves the file and the next
; start needs the sidecar's stale-socket probe to clear it.
(allow apse_app_t user_tmp_t (sock_file (create getattr open read write unlink)))
(allow apse_app_t user_tmp_t (unix_stream_socket (accept bind connectto create getattr read write)))
; the sandbox's own /tmp is a fresh tmpfs: its mount root carries
; the unlabeled-mount default label tmpfs_t (filecons do not
; label fresh inodes on unlabeled mounts — the /tmp filecon
; labels the host's /tmp, which is tmp_t) — the app stats it and
; searches it on every cwd-relative access. The tmp_t rule covers
; a host /tmp bind-mounted in by a profile (a bind carries the
; inode's tmp_t SID with it).
; `tmp_t` file create/write: the on-demand shim compile's compiler
; children (cc1/as/ld — each `exec`s `bin_t` out of a `apse_t`
; parent and takes this domain through the `typetransition` above;
; only the driver `cc` itself is kept `apse_t` by the pinned exec
; context, LESSONS #42) stage their temp files in the host's `/tmp`.
(allow apse_app_t tmp_t (dir (getattr open read search write add_name remove_name)))
(allow apse_app_t tmp_t (file (append create getattr map open read write unlink)))
(allow apse_app_t tmpfs_t (dir (getattr open search read)))
(allow apse_app_t tmpfs_t (file (append create getattr map open read write unlink)))
(allow apse_app_t session_dbusd_tmp_t (sock_file (getattr open read write)))
(allow apse_app_t unconfined_dbusd_t (unix_stream_socket (accept connectto getattr read write getopt setopt)))
(allow unconfined_dbusd_t apse_app_t (unix_stream_socket (accept getattr read write)))
(allow apse_app_t unconfined_dbusd_t (dbus (send_msg)))
(allow unconfined_dbusd_t apse_app_t (dbus (send_msg)))
(allow apse_app_t unconfined_t (dbus (send_msg)))
(allow apse_app_t node_t (node (recvfrom sendto tcp_recv tcp_send udp_recv udp_send)))
; the app's own unix sockets (socketpairs, local listeners):
; same socket-class self-permissions as its tcp/udp rule set
(allow apse_app_t apse_app_t (unix_stream_socket (accept bind connect connectto create getattr read write getopt setopt listen)))
; the app's own /proc/<pid> pident links (cwd/exe/root) carry the
; process's own context (the whole /proc/<pid>/ tree, LESSONS
; #45), so a lib that resolves its own path (and `stat
; /proc/self/exe` in general) hits an `apse_app_t` lnk_file, not a
; `proc_t` one. `read` (the readlink) and `getattr` (the lstat that
; yields the target name — without it `ls -la /proc/self` prints
; `l??????????`, LESSONS #61) are separate checks. `lock` (F_SETLK on
; an open link fd) and `ioctl` (an ioctl on the link's own fd — the
; full `domain.te` self-grant shape, v2.25) round it out. The self
; grant is MCS-bounded in effect (the note on the dir:ioctl rule
; below)
(allow apse_app_t apse_app_t (lnk_file (getattr lock read ioctl)))
; pipes the app creates for itself (its own child's stdio, internal
; plumbing) carry the app's own type; FIONBIO on one is a plain
; `ioctl` (0x542a), as bash and friends do on any pipe.
(allow apse_app_t apse_app_t (fifo_file (getattr ioctl read write)))
(allow apse_app_t apse_app_t (tcp_socket (create getattr name_bind connect read write getopt setopt)))
(allow apse_app_t apse_app_t (udp_socket (create getattr name_bind connect read write getopt setopt)))
; the standard /dev nodes the build binds in (the bind keeps their
; genfs labels — `null_device_t` covers both /dev/null and
; /dev/full): the app's stdio and entropy plumbing. The profiles
; mimic the base policy's user-session grants: the `domain` set
; for null/zero/urandom/tty; the usertype-only read set for
; /dev/random. `write` on /dev/urandom is not in the base set
; (the `domain` grant is read-only), so it is dropped
(allow apse_app_t null_device_t (chr_file (append getattr ioctl lock open read write)))
(allow apse_app_t urandom_device_t (chr_file (getattr ioctl lock open read)))
(allow apse_app_t random_device_t (chr_file (getattr ioctl lock open read)))
(allow apse_app_t zero_device_t (chr_file (append getattr ioctl lock map open read write)))
(allow apse_app_t ptmx_t (chr_file (open read write getattr ioctl)))
(allow apse_app_t devtty_t (chr_file (append getattr ioctl lock open read write)))
; the sandbox's `/dev/ptmx` is a relative symlink into the fresh
; devpts instance (the build's step 5, decision #39), so the symlink
; itself carries the fresh tmpfs's default label (tmpfs_t), not
; ptmx_t — following it is an `lnk_file read` on tmpfs_t. The
; fresh instance's own ptmx is devpts_t (the host's genfs label for
; /dev/pts/ptmx), and the dynamically created slaves are
; user_devpts_t (the same genfs match the host's /dev/pts/N get).
; grantpt/unlockpt (TIOCSPTLCK/TIOCGPTN) are ioctls on the master;
; winch handling is an ioctl on the slave. `ls -la /dev` lstats the
; link itself: `getattr` is a separate check from `read` (without
; it the entry prints `l??????????` — getdents knows it is a link,
; the lstat is denied, the target name never appears)
(allow apse_app_t tmpfs_t (lnk_file (getattr read)))
; fish maps its controlling tty back to a `/dev/pts/<N>` name by
; enumerating the (fresh, per-instance) devpts root: the direct
; grant is the base guest set (`ioctl lock read`, the `read` being
; the readdir), `open`/`search`/`getattr` for the root come from
; the `filesystem_type:dir` grant below (devpts_t is in the
; attribute); the `user_devpts_t` slaves match the base guest
; profile (append/lock/setattr included)
(allow apse_app_t devpts_t (dir (ioctl lock read)))
(allow apse_app_t devpts_t (chr_file (open read write getattr ioctl)))
(allow apse_app_t user_devpts_t (chr_file (append getattr ioctl lock open read setattr write)))
; the compositor's keymap file: wlroots writes each client's XKB
; keymap to a shm file (`/dev/shm/wlroots-*` — `user_tmp_t`, the
; file transition a `unconfined_t` creator gets there), hands the
; fd to the client out-of-band, and unlinks it. The app only ever
; `mmap`s the passed fd (the path is gone by then), so this is
; `map` (plus the plain file reads for completeness).
(allow apse_app_t user_tmp_t (file (getattr open read map)))
(allow apse_app_t dri_device_t (chr_file (open read write getattr)))
; `ps` lists the process table: `open` for the `opendir` call and
; `read` (readdir) for the enumeration of /proc. The /proc/<pid>
; entries themselves take the target process's own context (on this
; kernel the whole /proc/<pid>/ tree is labeled with it, LESSONS
; #45), so the files under them are the self grant below
(allow apse_app_t proc_t (dir (getattr open read search)))
(allow apse_app_t proc_t (file (getattr open read)))
; the top-level /proc self-links (self, cwd, exe, root,
; thread-self, mounts) are proc_t by the genfs rule; `ls /proc`
; readlinks them (`read`) and lstats them (`getattr` — the target
; name; without it the entry prints `l??????????`)
(allow apse_app_t proc_t (lnk_file (getattr read)))
; `/proc/net` is a *relative* symlink to `self/net` (the
; process's own net view — the /proc/<pid>/net dir is self-
; labeled, its files are proc_net_t): following it needs `read`
; on the link (the follow check), `ls /proc` lstats it. The
; content behind is read-only network state (in the sandbox, the
; private netns — loopback only), so file open/read and the
; can/ip/… subdirs' enumeration are granted, no write
(allow apse_app_t proc_net_t (lnk_file (getattr read)))
(allow apse_app_t proc_net_t (file (getattr open read)))
(allow apse_app_t proc_net_t (dir (getattr open read search)))
; `ls /proc` stats every top-level entry, most with their own
; type — getattr only (stat, no content). The two base-policy
; attributes collapse the whole family: `proc_type` (the /proc/*
; genfs types) and `sysctl_type` (the /proc/sys/* subtree types).
; `getattr` is the stat — it carries no content, so the grant
; covers every *current and future* entry (a new /proc type needs
; no new rule — that was the whack-a-mole of the earlier tuning
; rounds; the base policy expresses the same as one attribute,
; e.g. container_userns_t targets `proc_type` once). The libsepol
; CIL reader takes ONE class per `allow` (LESSONS #67), so each
; attribute still spells one rule per class. Content access
; (open/read) stays per-type below. `mtrr_device_t` is the one
; /proc type in neither attribute — a single-rule exception.
(allow apse_app_t proc_type (file (getattr)))
(allow apse_app_t proc_type (dir (getattr)))
(allow apse_app_t proc_type (lnk_file (getattr)))
(allow apse_app_t sysctl_type (file (getattr)))
(allow apse_app_t sysctl_type (dir (getattr)))
(allow apse_app_t sysctl_type (lnk_file (getattr)))
(allow apse_app_t mtrr_device_t (file (getattr)))
; `df` (even with an explicit path) `statfs`es the root of every
; mount it sees; the statfs is mediated against the *filesystem*
; type of the mounted fs — the `filesystem` class, the
; `filesystem_type` attribute family (fresh tmpfs mounts, the
; btrfs root, /proc, /sys, cgroup2, …). `getattr` = superblock
; metadata (fs type, size, free) — no content, so one attribute
; grant covers every mount the app may stat
(allow apse_app_t filesystem_type (filesystem (getattr)))
; the attribute's `dir` side: `getattr`/`open`/`search` on the
; root dir of any of those mounts — this is what carries the
; devpts root enumeration (fish, above) now that the direct
; `devpts_t:dir` grant is the base guest set
(allow apse_app_t filesystem_type (dir (getattr open search)))
; The broad `file_type:* map` grant that lived here (v2.25 — the
; PROT_NONE case of the `domain_can_mmap_files` tunable; content-
; free, but on the *whole file class*) was dropped in v2.28 as
; too broad for the default position. A/B-verified inert on this
; kernel: identical `mmap()` behavior with it present (v2.27) and
; absent, zero new denials, and the v2.25 per-prot premise
; (LESSONS #68) produced no denial where its model predicts one —
; on this kernel file access is gated by `open()`. Revisit on an
; *actual* `map` AVC — the likely source is a future
; kernel/Fedora update: the vanilla 7.2.15 source does wire the
; 7.2 replacement `mmap_file` hook (a `FILE__MAP` + per-prot
; check) into the `mmap()` and `mremap` paths (LESSONS #71). The
; per-type `map` grants (tmp_t, user_tmp_t, the state tree, the
; self rule) stay — the `domain.te` shape, and they cover those
; hook paths.
(allow apse_app_t security_t (filesystem (getattr)))
; `ps` walks the /sys CPU/NUMA tree (/sys/devices/system/…) for the
; processor count: `open`/`read` for the enumeration, `search` for
; the path components
(allow apse_app_t sysfs_t (dir (getattr open read search)))
(allow apse_app_t sysfs_t (file (getattr open read)))
; `ps` stats its own process's /proc/<pid> dir with a tty probe
; ioctl (TIOCGPTN). The self grant is MCS-bounded in effect: a
; single-level `s0:cN` subject dominates only objects at the same
; category, so it never reaches another instance's processes
(allow apse_app_t apse_app_t (dir (ioctl)))
(allow apse_app_t selinux_config_t (dir (getattr search)))
(allow apse_app_t selinux_config_t (file (getattr open read)))
(allow apse_app_t cgroup_t (dir (getattr open search read)))
(allow apse_app_t cgroup_t (file (getattr open read)))
; v2.26 (the `????` fix, revised the same day): a confined
; `ls -l /etc` showed `d??????????` / `l??????????` for ~42
; entries. Their inodes carry the base policy's *dedicated*
; config types (`auditd_etc_t`, `avahi_conf_t`, `bluetooth_conf_t`,
; `cupsd_etc_t`, `dbusd_etc_t`, `dhcp_etc_t`, `dnsmasq_etc_t`,
; `exports_t`, `firewalld_etc_rw_t`, `ipsec_key_file_t`,
; `kmscon_conf_t`, `lvm_etc_t`, `mcelog_etc_t`, `modules_conf_t`,
; `named_conf_t`, `net_conf_t`, `NetworkManager_etc_t`,
; `openvpn_etc_t`, `pppd_etc_t`, `samba_etc_t`, `sssd_conf_t`,
; `syslog_conf_t`, `system_cron_spool_t`, `tuned_etc_t`,
; `vmtools_unconfined_exec_t`, `locale_t`, …) — not `etc_t` (the
; rules above cover it) — and none of them had a rule, so
; `stat(2)` on each inode was denied. Listing itself worked (the
; /etc dir is `etc_t`: `dir read`/`search`), which is why the
; names were visible but the metadata was not.
;
; First cut (d79fc41): the same read-only set pointed at
; `non_auth_file_type` (3213 members) — that cleared all 42 (42 →
; 4, only `shadow_t` left). But that attribute is broader than the
; `domain` baseline: the base policy's `domain` attribute targets
; *no* `non_auth_file_type` rule at all (verified as-written with
; `sesearch -ds -s domain -A -c filesystem` — its broad reads come
; from the `files_unconfined_type` *source* side, unconfined-only,
; plus named types), and the only Fedora rules that target
; `non_auth_file_type` are system tools (tmpfiles, restorecon).
;
; Revised grant (user's least-privilege call, 2026-11-13): exactly
; the `domain` baseline file read set, as written, on the two
; base sets only — `base_file_type` (23 members: `etc_t`,
; `system_conf_t`, `etc_runtime_t`, `usr_t`, `bin_t`, `lib_t`,
; …) and `base_ro_file_type` (11, all ⊆ the former). Read-only:
; no `write`/`create`/`add_name`/`remove_name`/`setattr`/
; `execute*`; `open`/`ioctl`/`lock` are the read-class verbs the
; domain set carries.
;
; Deliberate cost: the ~28 dedicated config types are members of
; *neither* base set (verified with `seinfo -x`), so they remain
; `????` in `ls -l /etc` (count back to 45: those, plus the four
; `shadow_t` auth files, which `domain` cannot stat either — only
; the off-gated `file_type:map`; `dontaudit`'d, so no audit spam).
; That is cosmetic: the app cannot use those files meaningfully
; anyway, and an app that actually needs one gets a dedicated
; rule on denial — the tuning principle. Enumerating the ~28
; types individually was considered and rejected as the same
; distro-relabel fragility the exec world has (task 8.8). The
; v2.24/2.25 /proc closure is preserved: `sysctl_kernel_t`/
; `sysctl_net_t`/`sysctl_vm_t` and `proc_net_t` are members of
; neither base set.
;
; `apse_t` gets no such grant: the supervisor reads no broad file
; set, and the denial-driven principle applies to it too.
;
; Verified in enforcing mode (2026-11-13, both cuts): the first
; cut took the `????` count 42 → 4; this cut takes it back to 45
; (the dedicated types incl. `hosts`/`hostname`/`machine-id`/
; `localtime`/`resolv.conf` — the task 8.10 per-instance files —
; plus the four shadow files), and the run produced no new
; denials of any kind.
(allow apse_app_t base_file_type (dir (getattr open search)))
(allow apse_app_t base_file_type (lnk_file (getattr read)))
(allow apse_app_t base_ro_file_type (dir (ioctl lock read)))
(allow apse_app_t base_ro_file_type (file (getattr ioctl lock open read)))
(allow apse_app_t home_root_t (dir (getattr open read search)))
(allow apse_app_t user_home_dir_t (dir (getattr open search read)))
(allow apse_app_t user_home_t (dir (create getattr open search read write add_name remove_name)))
(allow apse_app_t cache_home_t (dir (create getattr open search read write add_name remove_name)))
; `lock`/`watch`: fish takes a lock and an inotify watch on its
; config dir (live-reload)
(allow apse_app_t config_home_t (dir (create getattr open search read write add_name remove_name lock watch)))
(allow apse_app_t data_home_t (dir (create getattr open search read write add_name remove_name)))
; `lock`/`watch`: in the private home (decision #43) fish's config
; dir lives in this tree, so it gets the same flock/inotify grants
; as `config_home_t` above (host mode) — live-reload
(allow apse_app_t gconf_home_t (dir (create getattr open search read write add_name remove_name lock watch)))
; `setattr`/`rename`: fish's atomic save — write a temp file,
; `fchmod`/`ftruncate` it (setattr), then `rename` it over the
; final name (variables, history, completions)
(allow apse_app_t user_home_t (file (append create entrypoint execute execute_no_trans getattr map open read write setattr rename unlink)))
(allow apse_app_t cache_home_t (file (append create getattr map open read write setattr rename unlink)))
(allow apse_app_t config_home_t (file (append create getattr map open read write setattr rename unlink)))
(allow apse_app_t data_home_t (file (append create getattr map open read write setattr rename unlink)))
; `entrypoint`: the check of the *new* (exec-context) context at
; the `apse_t` → `apse_app_t` exec when B execs a file out of the
; private home; `execute_no_trans`: the app's own children
; re-execing such a file (they stay `apse_app_t` — no transition
; rule from the app type).
(allow apse_app_t gconf_home_t (file (append create entrypoint execute execute_no_trans getattr map open read write setattr rename unlink)))
; the private-home parallel: in `home = "private"` mode (the
; default) the app's whole home resolves into the per-app state
; tree, whose inodes are `apse_state_t` — so every grant the app
; has on the home-dir types above applies here too, incl.
; `lock`/`watch` (fish's config-dir live-reload) and the
; `entrypoint`/`execute`/`execute_no_trans` file set. In host mode
; the app never sees this type (the real home is the gconf/config/
; cache/data family above).
(allow apse_app_t apse_state_t (dir (create getattr open search read write add_name remove_name lock watch)))
(allow apse_app_t apse_state_t (file (append create entrypoint execute execute_no_trans getattr map open read write setattr rename unlink)))
; `ioctl`: at exec, the loader (and some apps, e.g. nroff) probe
; the file with a tty ioctl (TCGETS2) — checked against the file's
; type (the same class as the shim's TCGETSID, LESSONS #40); the
; probe fails with ENOTTY either way, so `ioctl` is all that is
; needed for it to behave as out-of-sandbox
(allow apse_app_t bin_t (file (entrypoint execute execute_no_trans getattr ioctl map open read)))
; `ioctl`: the shim's `ld.so` runs before the `xserver_t` transition
; settles, in `apse_app_t`; it probes candidate `.so` files with
; `TCGETSID` (its `isatty`-style check) and that ioctl is checked
; against the file's type
(allow apse_app_t lib_t (file (entrypoint execute execute_no_trans getattr ioctl map open read)))
; decision #42: the post-exec pdeathsig-restore shim (the bridle of
; the B←A cascade leg). The confined exec into `apse_app_t`
; changed the process's SID, so `selinux_bprm_committing_creds`
; (`security/selinux/hooks.c:2545`, commit 4ac212ad4e8f) zeroed the
; belt; the app's glibc loader then maps the `.so` (open/fstat plus
; the mmap — on 7.2 a `PROT_EXEC` mapping needs `file:execute`, not
; only `map`), and its constructor re-arms the signal.
(allow apse_app_t apse_shim_t (file (execute getattr map open read)))
(allow apse_app_t apse_shim_t (fd (use)))
(allow apse_app_t usr_t (file (entrypoint execute execute_no_trans getattr map open read)))
; the app resolves and stats the system trees it execs from
; (path lookup = search on every dir of the path; stat = getattr;
; symlinked components = lnk_file read for readlink, and — on this
; kernel — a distinct `getattr` for `stat()` through the link;
; without these even `stat /` and PATH lookup fail):
; fish's completion system enumerates /usr/bin and /bin to list
; the available commands: `open` for the `opendir` call, `read`
; (readdir) for the enumeration
; the same completion then stats *every enumerated entry*: Fedora
; labels most of /usr/bin/* and /usr/libexec/* with per-purpose
; exec types (lvm_exec_t, iptables_exec_t, systemd_systemctl_exec_t,
; …) that sit in *neither* base set, so the base-set grant above
; reaches only the base-set-labelled entries — the `exec_type`
; attribute (every `*_exec_t`) is the complete target. `getattr`
; (stat) on the files; on the symlinks among them `getattr` +
; `read` (readlink is a separate check on this kernel)
(allow apse_app_t exec_type (file (getattr)))
(allow apse_app_t exec_type (lnk_file (getattr read)))
; fontconfig's directory scans: the system tree and the user's
; `~/.local/share/fonts`; `$XDG_DATA_HOME` enumeration stats every
; subdirectory, including flatpak_home_t. `cpu_online_t` is
; glibc's read of /sys/devices/system/cpu/online. `read` (readdir)
; is what makes the directories enumerable — without it fontconfig
; cannot find the user's fonts at all and the app's font load
; fails (a `getattr`-only grant is the trap here).
(allow apse_app_t fonts_t (dir (getattr open search read)))
(allow apse_app_t fonts_t (file (getattr open read map)))
; `open` (in addition to `read`): fontconfig `open()`s each user font
; dir before `getdents`-ing it — a `read`-only grant passes the
; permission check but the `open(2)` itself is still denied, so the
; directory is never enumerated (LESSONS #35: the silent-degradation
; class, where a partial grant looks fine but the op still fails).
(allow apse_app_t user_fonts_t (dir (getattr open search read)))
(allow apse_app_t user_fonts_t (file (getattr open read map)))
; the fontconfig caches (`/var/cache/fontconfig`,
; `~/.cache/fontconfig`): read the dir and its index files. If the
; app cannot refresh a stale cache, fontconfig falls back to a live
; directory scan, which the grants above allow — so the caches need
; no write access.
; the app receives the compositor's keymap fd through the relay
; (SCM_RIGHTS): the receive-side `fd:use` against the file's type
(allow apse_app_t user_tmp_t (fd (use)))
; `map`: fontconfig mmaps the cache index files before reading them
(allow apse_app_t fonts_cache_t (dir (getattr search read)))
(allow apse_app_t fonts_cache_t (file (getattr open read map)))
(allow apse_app_t user_fonts_cache_t (dir (getattr search read)))
(allow apse_app_t user_fonts_cache_t (file (getattr open read map)))
(allow apse_app_t flatpak_home_t (dir (getattr search read)))
(allow apse_app_t cpu_online_t (file (getattr open read)))
; `open`/`read`: `ls /` — `open(2)` on a directory is checked
; against `dir:open` (the same trap as the fontconfig dirs,
; LESSONS #35: a `read`-only grant still fails the open), and the
; subsequent `getdents` needs `read`
(allow apse_app_t root_t (dir (getattr open search read)))
; glibc/bash NSS lookups (getpwuid): /etc/passwd
(allow apse_app_t passwd_file_t (file (getattr open read)))
; fstat on the host-created stdio pipes inherited into the sandbox
(allow apse_app_t unconfined_t (fifo_file (getattr)))
; the dynamic linker itself: open (its fstat) plus execute/map/read
(allow apse_app_t ld_so_t (file (execute map open read getattr)))
(allow apse_app_t ld_so_cache_t (file (getattr map open read)))
; `getattr`: git (and glibc) stat /usr/share/locale for
; translations before falling back to the C locale
(allow apse_app_t locale_t (dir (getattr search)))
(allow apse_app_t locale_t (file (getattr map open read)))
; man: stats the man search dirs, enumerates the section
; subdirs (`man1`/`man6`/`man8` — `open`/`read`, the same
; dir-open trap), and reads the page files (all `man_t`); no
; cache access needed — a miss is a clean "No manual entry"
(allow apse_app_t man_t (dir (getattr open search read)))
; `ioctl`: man queries the page file's extents (FS_IOC_FIEMAP)
; before reading it — a read-only probe
(allow apse_app_t man_t (file (getattr ioctl open read)))
; `ls /` stats every entry of the root dir; /afs (mnt_t) is the
; one unmasked entry whose type is not covered above
(allow apse_app_t mnt_t (dir (getattr open search read)))
; ls formatting mtimes: tzset reads /etc/localtime, a symlink
; (labeled locale_t, not etc_t) into the zoneinfo tree
(allow apse_app_t locale_t (lnk_file (read)))
; /proc/sys: platform/runtime introspection (read-only; the values
; are kernel-constant, not instance data)
(allow apse_app_t sysctl_t (dir (getattr search)))
; `/proc/sys/kernel` is its own type (like the vm/crypto subtrees
; above); procps's `ps` walks it for `pid_max` (the process-table
; size) and stats the dir on the way
(allow apse_app_t sysctl_kernel_t (dir (getattr open read search)))
(allow apse_app_t sysctl_kernel_t (file (getattr open read)))
; `df` stats /proc/sys/fs/binfmt_misc to detect that mount:
; `search` of the /proc/sys/fs dir (its own sysctl_* type, like
; the kernel/vm/crypto subtrees above) and the stat of the entry
(allow apse_app_t sysctl_fs_t (dir (getattr search)))
(allow apse_app_t sysctl_fs_t (file (getattr open read)))
; `sysctl_vm_t` is the /proc/sys/vm subtree (a distinct type, not
; `sysctl_t`): foot's glibc stats it for runtime tuning.
(allow apse_app_t sysctl_vm_t (dir (getattr search)))
; `/proc/sys/vm/overcommit_memory` has its own type; glibc's malloc
; runtime tuning reads it
(allow apse_app_t sysctl_vm_overcommit_t (file (getattr open read)))
; `/proc/sys/crypto` is its own type (the FIPS and af_alg kernel
; knobs); the app's runtimes probe it at init
(allow apse_app_t sysctl_crypto_t (dir (getattr search)))
(allow apse_app_t sysctl_crypto_t (file (getattr open read)))
; the system's cert stores: /etc/pki and /etc/ssl (`cert_t`), plus
; the per-service stores the `cert_type` attribute covers — apps
; read public keys / trust data from any of them. The grant profile
; mimics the base sets' read-only attribute grants (the
; `lnk_file` rule covers the hashed symlink tree under
; /etc/ssl/certs); the app never writes trust data
(allow apse_app_t cert_type (dir (getattr ioctl lock open read search)))
(allow apse_app_t cert_type (file (getattr ioctl lock open read)))
(allow apse_app_t cert_type (lnk_file (getattr read)))
; VFS superblock objects are stat'd during path lookup on some
; mount types (`filesystem getattr`): `fs_t` is the default sb
; label and is *not* in `file_type`; the `file_type` grant (the
; base guest profile) covers the file-labelled superblocks —
; the fresh tmpfs trees, /proc, /sys, cgroup2, devpts
(allow apse_app_t fs_t (filesystem (getattr)))
(allow apse_app_t file_type (filesystem (getattr)))
(allow apse_app_t xserver_t (unix_stream_socket (connectto read write)))
(allow xserver_t apse_app_t (unix_stream_socket (read write)))
; the satellite's fds (the displayfd socketpair, the listening X
; socket, the /dev/null dup) carry their creator's SID — `apse_t`
; — and Xwayland reads/writes them after the transition: `fd:use`
; and the socket object's own `read`/`write` are both checked
; against the *creator's* type, not the file's
(allow xserver_t apse_t (fd (use)))
(allow xserver_t apse_t (unix_stream_socket (accept connectto getopt getattr read write shutdown)))
; the `-auth` file: the sidecar leaves it to the server, which creates
; it on startup (a fresh magic cookie) — needs create/append/write,
; not just read
(allow xserver_t user_tmp_t (file (append create getattr open read write)))
; decision #37: the Xwayland satellite's own shim (the same
; mechanism, `SIGTERM`): its `xserver_t` transition changes the SID
; (the belt is cleared), and the satellite's glibc loader maps the
; `.so` to re-arm it — the same `file:execute` requirement as the
; app's.
(allow xserver_t apse_shim_t (file (execute getattr map open read)))
(allow xserver_t apse_shim_t (fd (use)))
(allow xserver_t user_tmp_t (sock_file (getattr open read)))
(allow xserver_t user_tmp_t (unix_stream_socket (accept getattr read write)))
; Xwayland binds and listens its own X socket (the satellite
; hands a listening fd over to the compositor)
(allow xserver_t xserver_t (unix_stream_socket (accept bind connect create getattr read write listen)))
; systemd (init_t) does cgroup bookkeeping on the per-instance
; sub-cgroup directories (created by apse, so they carry the
; process contexts, not cgroup_t)
(allow init_t apse_t (dir (getattr read search)))
(allow init_t apse_t (file (getattr ioctl open read)))
(allow init_t apse_app_t (dir (getattr read search)))
(allow init_t apse_app_t (file (getattr ioctl open read)))
; the binary's filecon below lands on the root fs (a seclabel btrfs
; here), whose sb carries `fs_t`: both the setxattr relabel path and
; `may_create` then check `filesystem:associate`, whose *subject* is
; the **new** label's SID (this type) — the base policy grants that
; to the `file_type` attribute, which a module type is not a member
; of, so an existing file labelled `bin_t` could never be relabelled
; to `apse_exec_t` in enforcing mode (the October install went through
; only because the tuning loop ran permissive).
